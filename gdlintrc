class-definitions-order:
  - tools
  - classnames
  - extends
  - docstrings
  - signals
  - enums
  - consts
  - staticvars
  - exports
  - pubvars
  - prvvars
  - onreadypubvars
  - onreadyprvvars
  - others
max-line-length: 130
max-file-lines: 1000
max-public-methods: 40
max-returns: 8
function-arguments-number: 12
excluded_directories: !!set
  .git: null
  .godot: null
